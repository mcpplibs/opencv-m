    a = a / b;
    return a;
}

template<typename _Tp> requires opencv_m_pick<_Tp> inline Scalar operator * (const Matx<_Tp, 4, 4>& a, const Scalar& b)
{
    Matx<double, 4, 1> c((Matx<double, 4, 4>)a, b, Matx_MatMulOp());
    return reinterpret_cast<const Scalar&>(c);
}
} } // cv::opencv_m_repl
