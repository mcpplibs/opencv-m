import std;
import mcpplibs.mwrap.opencv;

int main() {
    namespace macros = mcpplibs::mwrap::opencv::macros;
    cv::Mat image(64, 64, macros::CV_8UC3, cv::Scalar(20, 80, 160));
    cv::Mat gray;
    cv::cvtColor(image, gray, cv::COLOR_BGR2GRAY);
    if (gray.rows != 64 || gray.cols != 64 || gray.channels() != 1) return 1;
    if (!cv::imwrite("out.png", gray)) return 2;
    std::println("OpenCV {}: wrote {}x{} out.png", cv::getVersionString(), gray.cols, gray.rows);
}
