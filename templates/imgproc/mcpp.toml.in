[package]
name        = "{{project.name}}"
version     = "0.1.0"
description = "OpenCV image pipeline ({{project.name}})"

[dependencies]
"{{self.name}}" = { version = "{{self.version}}", features = ["imgproc", "imgcodecs-png", "imgcodecs-jpeg"] }

[targets.{{project.name}}]
kind = "bin"
main = "src/main.cpp"
