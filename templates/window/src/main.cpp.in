import std;
import mcpplibs.mwrap.opencv;

int main(int argc, char** argv) {
    const bool smoke = argc > 1 && std::string_view(argv[1]) == "--smoke-test";
    const auto backend = cv::currentUIFramework();
    if (backend.empty()) return 1;
    cv::Mat image(128, 192, mcpplibs::mwrap::opencv::macros::CV_8UC3, cv::Scalar(30, 90, 180));
    cv::namedWindow("{{project.name}}", cv::WINDOW_NORMAL);
    cv::imshow("{{project.name}}", image);
    std::println("OpenCV window backend: {}. Press a key in the window to close it.", backend);
    cv::waitKey(smoke ? 100 : 0);
    const auto rect = cv::getWindowImageRect("{{project.name}}");
    const bool displayed = rect.width > 0 && rect.height > 0;
    cv::destroyAllWindows();
    cv::waitKey(10);
    return displayed ? 0 : 2;
}
